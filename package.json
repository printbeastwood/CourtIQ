{
  "name": "courtiq",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@courtiq/api",
    "dev:dashboard": "turbo dev --filter=venue-dashboard",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "setup": "bash scripts/setup.sh",
    "db:push": "cd packages/db && npx drizzle-kit push --force",
    "db:seed": "npx tsx packages/db/src/seed.ts",
    "db:migrate": "node packages/db/dist/migrate.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "expo-calendar": "~14.0.6"
  }
}
