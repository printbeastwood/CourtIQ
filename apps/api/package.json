{
  "name": "@courtiq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --reporter=verbose src/__tests__/*.integration.test.ts"
  },
  "dependencies": {
    "@courtiq/adapters": "*",
    "@courtiq/concierge": "*",
    "@courtiq/db": "*",
    "@courtiq/preference-store": "*",
    "@courtiq/rating-engine": "*",
    "@courtiq/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "bullmq": "^5.71.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.7.0",
    "ioredis": "^5.10.1",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}
